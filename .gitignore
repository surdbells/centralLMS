# ---- dependencies ----
node_modules/
vendor/
.pnpm-store/

# ---- build output ----
dist/
build/
www/
out-tsc/
.angular/
.turbo/
*.tsbuildinfo

# ---- env & secrets ----
.env
.env.*
!.env.example
*.pem
*.key
!apps/api/config/*.key.example

# ---- runtime / cache ----
apps/api/var/
coverage/
.phpunit.result.cache
.php-cs-fixer.cache
.phpstan.cache/

# ---- native mobile build artifacts ----
apps/mobile/android/
apps/mobile/ios/
!apps/mobile/android/.gitkeep
!apps/mobile/ios/.gitkeep

# ---- editors / os ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp

# ---- legacy drop zone ----
# legacy/ IS committed (reference material for the rewrite), but never its
# dependency trees, build output or raw database dumps containing real data.
legacy/**/node_modules/
legacy/**/vendor/
legacy/**/dist/
legacy/**/.angular/
legacy/db/*.dump
legacy/db/*.tar
legacy/db/data/
legacy/_inbox/*
!legacy/_inbox/.gitkeep
!legacy/_inbox/README.md

# ---- legacy files containing live credentials ----
# These are excluded so the secrets below never enter git history.
# Commit REDACTED copies instead once the credentials have been rotated.
#   legacy/backend/config/Database.php      live MySQL host/user/password
#   legacy/frontend/src/environments/       Zoom API key
legacy/backend/config/Database.php
legacy/frontend/src/environments/environment*.ts

# Further legacy files found to contain live credentials. Same rule as above:
# excluded so the secrets never enter git history; commit REDACTED copies once
# the credentials have been rotated.
#   legacy/backend/codebase/public/config.php   a second database's credentials
legacy/backend/codebase/public/config.php
legacy/frontend/src/app/live-training/services/video-integration.service.ts

# Claude Code session state
.claude/
