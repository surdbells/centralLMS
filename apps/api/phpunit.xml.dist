<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" bootstrap="tests/bootstrap.php" cacheDirectory="var/cache/.phpunit" colors="true" executionOrder="depends,defects" failOnRisky="true" failOnWarning="true" beStrictAboutOutputDuringTests="true" displayDetailsOnTestsThatTriggerWarnings="true" displayDetailsOnTestsThatTriggerErrors="true">
  <testsuites>
    <!-- No I/O, no network, no database. Must stay fast enough to run on
             every save. -->
    <testsuite name="unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <!-- Needs the docker-compose stack up (`pnpm up`). -->
    <testsuite name="integration">
      <directory>tests/Integration</directory>
    </testsuite>
  </testsuites>
  <source restrictNotices="true" restrictWarnings="true" ignoreIndirectDeprecations="true">
    <include>
      <directory>src</directory>
    </include>
  </source>
  <php>
    <env name="APP_ENV" value="test" force="true"/>
    <env name="APP_DEBUG" value="true" force="true"/>
    <!-- Fixed, obviously-fake secret: tests must never depend on a real one. -->
    <env name="JWT_SECRET" value="test-secret-that-is-long-enough-to-pass-validation" force="true"/>
    <env name="RATE_LIMIT_ENABLED" value="false" force="true"/>
  </php>
</phpunit>
