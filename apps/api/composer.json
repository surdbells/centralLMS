{
  "name": "central/api",
  "description": "Central LMS API — Slim 4 / PHP 8.3 / PostgreSQL 16",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-bcmath": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/migrations": "^3.8",
    "doctrine/orm": "^3.3",
    "dompdf/dompdf": "^3.1",
    "firebase/php-jwt": "^7.1",
    "guzzlehttp/guzzle": "^7.9",
    "league/flysystem": "^3.29",
    "league/flysystem-aws-s3-v3": "^3.29",
    "monolog/monolog": "^3.8",
    "php-di/php-di": "^7.0",
    "predis/predis": "^2.3",
    "ramsey/uuid": "^4.7",
    "sentry/sentry": "^4.10",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/cache": "^7.2",
    "symfony/console": "^7.2",
    "symfony/event-dispatcher": "^7.2",
    "symfony/messenger": "^7.2",
    "symfony/redis-messenger": "^7.2",
    "symfony/validator": "^7.2",
    "vlucas/phpdotenv": "^5.6",
    "zircote/swagger-php": "^4.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "Central\\Api\\": "src/",
      "Central\\Api\\Migrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Central\\Api\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8080 -t public public/index.php",
    "console": "php bin/console",
    "migrate": "php bin/console migrations:migrate --no-interaction",
    "openapi": "php bin/console openapi:generate",
    "test": "phpunit",
    "stan": "phpstan analyse --memory-limit=512M",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "serve": "Run the API on the PHP built-in server (dev only)",
    "check": "Run the full quality gate: codesniffer, phpstan, phpunit"
  }
}
