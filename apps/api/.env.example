# ---------------------------------------------------------------------------
# Central LMS API — copy to .env and fill in. NEVER commit .env
# ---------------------------------------------------------------------------

APP_ENV=dev                 # dev | test | prod
APP_DEBUG=true
APP_NAME="Central LMS"
APP_URL=http://localhost:8081
APP_TIMEZONE=Africa/Lagos

# Comma-separated origins allowed to call the API from a browser.
# 4300 = the web app, 4400 = the marketing/onboarding site, 4500 = the SaaS
# operator console. In production add the deployed origins for each
# (e.g. https://app.centrallms.com, https://centrallms.com, https://operator.centrallms.com).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400,http://localhost:4500,http://localhost:8100

# --- PostgreSQL 16 --------------------------------------------------------
DB_DRIVER=pdo_pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_NAME=central_lms
DB_USER=central_lms
DB_PASSWORD=central_lms   # matches infra/docker/docker-compose.yml; override in production
DB_SCHEMA=public

# --- Redis ----------------------------------------------------------------
REDIS_DSN=redis://127.0.0.1:6389
CACHE_NAMESPACE=central
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6389/messages

# --- JWT ------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=central-lms
JWT_AUDIENCE=central-clients
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120            # requests
RATE_LIMIT_WINDOW=60          # seconds

# --- Mail (ZeptoMail) -----------------------------------------------------
# zeptomail, or `log` to write messages to the log instead of sending them.
# `log` is the right setting for development: the whole path runs — route,
# queue, claim, send, mark sent — with no account anywhere, and a message that
# would have been wrong is visible in the log rather than in somebody's inbox.
MAIL_PROVIDER=zeptomail
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Central LMS"
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com/v1.1

# --- SMS / OTP (Termii) ---------------------------------------------------
# termii, or `log`. See MAIL_PROVIDER.
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=Bayti
TERMII_BASE_URL=https://api.ng.termii.com

# --- Push (Firebase Cloud Messaging) --------------------------------------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=config/firebase-service-account.json

# --- Object storage (S3-compatible) ---------------------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=central-lms
S3_KEY=
S3_SECRET=
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# --- ILT meeting providers (see docs/migration/ilt-rewrite.md) ------------
# These are OUR OAuth app registrations, one per platform, shared by all
# tenants. Each tenant then connects their own account through a consent
# screen; their access/refresh tokens are stored encrypted in the
# video_integrations table, never here.
ILT_REDIRECT_BASE_URL=http://localhost:8081

# Zoom — a "General App" (OAuth), not Server-to-Server.
# Scopes: meeting:write meeting:read user:read report:read:admin
ZOOM_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# Google Meet — OAuth client (Web application) in Google Cloud Console.
# Scopes: calendar.events, admin.reports.audit.readonly (attendance only)
GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Teams — Entra ID app registration, delegated permissions.
# Scopes: offline_access OnlineMeetings.ReadWrite OnlineMeetingArtifact.Read.All
TEAMS_ENABLED=false
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# --- Secrets at rest ------------------------------------------------------
# Encrypts tenant OAuth credentials. openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# --- Observability --------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug               # debug | info | notice | warning | error
LOG_PATH=var/log/app.log
