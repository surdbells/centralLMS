{
  "name": "@central/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Central LMS — the learner app. An Ionic + Angular app in a Capacitor native shell, talking to the same API as @central/web.",
  "scripts": {
    "dev": "ng serve --port 8100",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "sync": "cap sync",
    "mobile": "pnpm run build && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "doctor": "cap doctor",
    "art": "node scripts/generate-source-art.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor '#3316a6' --iconBackgroundColorDark '#161c2b' --splashBackgroundColor '#3316a6' --splashBackgroundColorDark '#0f1420'",
    "brand": "pnpm run art && pnpm run assets"
  },
  "dependencies": {
    "@angular/animations": "^19.2.11",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^8.4.3",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.7",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "sharp": "^0.33.5",
    "typescript": "~5.7.2"
  }
}
